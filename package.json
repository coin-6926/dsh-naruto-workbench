{
  "name": "naruto-power-workbench",
  "version": "0.1.0",
  "description": "火影忍者手游战力工作台：16 板块面板 → 战力构成 / 短板 / 虚战诊断 / 目标倒推。内置带来源与置信度的数值表（7 系数、属性伤害公式、勾玉/神器/通灵/秘卷消耗），提供 npm 包、npx CLI、单文件 HTML、DeepSeek Harness 插件四种用法。",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./dist/naruto-power.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./core": {
      "types": "./dist/naruto-power.d.ts",
      "require": "./dist/naruto-power.cjs",
      "import": "./dist/naruto-power.cjs"
    },
    "./html": "./dist/naruto-workbench.html",
    "./data": "./lib/power-data.js",
    "./dsh": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "naruto-power": "./dist/naruto-cli.cjs",
    "naruto-workbench": "./dist/naruto-cli.cjs"
  },
  "files": [
    "lib",
    "dist",
    "src",
    "cordis.patch.yml",
    "docs",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "naruto",
    "火影忍者",
    "火影忍者手游",
    "战力",
    "power-calculator",
    "game-tool",
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "cordis-plugin",
    "single-file-html",
    "offline",
    "cli",
    "umd",
    "npx"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coin-6926/dsh-naruto-workbench.git"
  },
  "homepage": "https://github.com/coin-6926/dsh-naruto-workbench#readme",
  "bugs": {
    "url": "https://github.com/coin-6926/dsh-naruto-workbench/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "node tests/selftest.mjs",
    "selftest": "node tests/selftest.mjs",
    "build:portable": "node tools/build-portable.mjs",
    "test:portable": "node tests/portable.test.mjs",
    "test:browser": "node tests/browser.e2e.mjs",
    "test:robust": "node tests/robustness.test.mjs",
    "test:stress": "node tests/stress.test.mjs",
    "test:all": "node tests/selftest.mjs && node tests/portable.test.mjs && node tests/robustness.test.mjs && node tests/stress.test.mjs && node tests/ui-constraint.test.mjs && node tests/browser.e2e.mjs",
    "cli": "node dist/naruto-cli.cjs",
    "official:get": "node tools/fetch-official.mjs",
    "official:search": "node tools/search-official.mjs",
    "prepack": "node tools/build-portable.mjs",
    "prepublishOnly": "node tools/build-portable.mjs && node tests/selftest.mjs && node tests/portable.test.mjs",
    "verify:pack": "node tools/verify-pack.mjs",
    "test:ui": "node tests/ui-constraint.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
